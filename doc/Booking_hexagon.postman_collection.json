        {
          "name": "room update inventories",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// today in UTC, the same \"today\" the service checks: a first_night before it is a 400",
                  "pm.variables.set(\"today\", new Date().toISOString().slice(0, 10));"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"first_night\": \"{{today}}\",\r\n    \"last_night\": \"2099-12-31\",\r\n    \"price\": 15000\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{room_url}}/api/v1/e4454ca2-773f-4750-8658-2703f5447a1c/inventories",
              "host": [
                "{{room_url}}"
              ],
              "path": [
                "api",
                "v1",
                "e4454ca2-773f-4750-8658-2703f5447a1c",
                "inventories"
              ]
            },
            "description": "Admin edit of the existing inventory days from first_night to last_night (YYYY-MM-DD, both inclusive, first_night not before today UTC). status (AVAILABLE | MAINTENANCE) and price (minor units, in the room's currency) are optional, but at least one is required; a missing field keeps the stored value. Any other field (e.g. currency) is a 400. 200 = the touched month rows ([] when the range has no inventory), 400 = bad input or a malformed id, 404 = unknown room, 409 = MAINTENANCE over a held night."
          },
          "response": []
        }
