# Template of ".env" file

# REST (Stripe webhook) and gRPC (CreatePaymentIntent) run on separate ports
SERVER_PORT=8180
GRPC_PORT=9180

DB_HOST=localhost
DB_PORT=5432
DB_USER=payment_service
DB_PASSWORD=payment_service
DB_NAME=payment_service

# Stripe sandbox: secret key from the dashboard (sk_test_...),
# webhook secret printed by `stripe listen` (whsec_...)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

KAFKA_BROKERS=localhost:9092
