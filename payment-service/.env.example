# Template of ".env" file

# REST (Stripe webhook) and gRPC (CreateCheckoutSession) run on separate ports
SERVER_PORT=8180
GRPC_PORT=9180

DB_HOST=localhost
DB_PORT=5432
DB_USER=payment_service
DB_PASSWORD=payment_service
DB_NAME=payment_service

# Stripe sandbox: secret key from the dashboard (sk_test_...),
# webhook secret printed by `stripe listen` (whsec_...)
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Where Stripe's hosted payment page sends the user after paying; {BOOKING_ID} is replaced.
# No frontend yet: point it at booking-service's GET booking endpoint.
# Use booking-service's real port (8180 is the shared template port, same as SERVER_PORT above)
STRIPE_SUCCESS_URL=http://localhost:8180/bookings/api/v1/{BOOKING_ID}

KAFKA_BROKERS=localhost:9092
